{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      // platform alone reads the commit sha (sentry release name, sourcemap
      // upload gate). in the root env it hashes into every member's build and
      // misses the remote cache on each commit. $TURBO_EXTENDS$ appends;
      // without it this array replaces the root's.
      "env": ["$TURBO_EXTENDS$", "VERCEL_GIT_COMMIT_SHA"]
    }
  }
}
