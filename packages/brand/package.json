{
  "name": "@better-giving/brand",
  "private": true,
  "description": "Shared Better Giving brand constants (legal identity, social profile urls, design-token color palette)",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./src/index.ts",
    "./colors.css": "./src/colors.css",
    "./flat": "./src/flat.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate-colors": "node ./src/scripts/generate-colors.ts"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "5.0.0"
  }
}
