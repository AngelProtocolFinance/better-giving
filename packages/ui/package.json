{
  "name": "@better-giving/ui",
  "private": true,
  "description": "Better Giving design system — shared React components, style layer, and pure helpers",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "engines": {
    "node": "24.x"
  },
  "exports": {
    ".": "./src/index.ts",
    "./helpers": "./src/helpers/index.ts",
    "./masks": "./src/components/form/masks/index.ts",
    "./tooltip": "./src/components/tooltip.tsx",
    "./hover-card": "./src/components/hover-card.tsx",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
    "build": "tailwindcss -i ./src/styles/build-entry.css -o ./dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run --bail 1",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "peerDependencies": {
    "@ark-ui/react": "^5.37.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.16.0",
    "valibot": "^1.3.1"
  },
  "dependencies": {
    "@better-giving/brand": "workspace:*",
    "date-fns": "4.1.0",
    "lucide-react": "0.562.0"
  },
  "devDependencies": {
    "@ark-ui/react": "5.37.2",
    "@tailwindcss/cli": "4.3.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.5",
    "playwright": "1.59.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.75.0",
    "react-router": "7.16.0",
    "tailwindcss": "4.3.1",
    "typescript": "catalog:",
    "valibot": "1.3.1",
    "vite": "8.1.5",
    "vitest": "4.1.5",
    "vitest-browser-react": "2.2.0"
  }
}
